{
  "CS2HanZipLine": {
    // 核心限制。MaxUses 与 LifetimeSeconds 为 0 时表示不限制。
    "Enable": true,
    "AdminOnlyCreate": false,
    // 管理员权限标志。多个标志用英文逗号分隔，命中任意一个即可管理；留空会禁用管理员菜单和管理指令。
    "AdminPermissions": "hanzipline.admin.manage",
    "MaxActivePairs": 64,
    "MaxPerPlayer": 10,
    "CreateCooldownSeconds": 8.0,
    "MinDistance": 128.0,
    "MaxDistance": 5000.0,
    "AnchorSeparation": 96.0,
    "UseRadius": 96.0,
    // true: CT、T、Bot 可以使用全部滑索。false: 只能使用本队和全局滑索。
    "AllowAllTeamsUseZiplines": true,
    // BOT 逻辑默认关闭。开启后会在 BotUseRange 内朝最近端点移动，进入 UseRadius 后由插件直接挂索，不模拟按键。
    "BotAllowUse": false,
    "BotUseRange": 160.0,
    "BotUseCooldownSeconds": 20.0,
    "BotTargetTimeoutSeconds": 5.0,
    "BotApproachSpeed": 450.0,
    "RideSpeed": 700.0,
    "ArrivalDistance": 48.0,
    "AlignmentSpeed": 240.0,
    "RideFlyDurationSeconds": 1.0,
    "StallTimeoutSeconds": 1.5,
    "MaxUses": 0,
    "LifetimeSeconds": 0.0,
    "ClearEachRound": true,

    // 端点模型会在 SetModel 和 SetScale 后的下一 tick 解析缆绳挂点。
    "AnchorModel": "models/props/cs_italy/it_streetlampleg.vmdl",
    "AnchorModelScale": 0.65,
    "BuildFlightModel": "weapons/models/grenade/decoy/weapon_decoy.vmdl",
    "BuildFlightModelScale": 1.0,
    "BuildFlightSpeed": 1800.0,
    "BuildFlightGravity": 800.0,
    "CableAttachmentHeightFallback": 144.0,
    "BeamWidth": 0.5,
    "BeamEndWidth": 0.5,
    "BeamHaloScale": 3.0,
    // 支持 RGB 或 RGBA。这三组颜色同时用于激光绳和管理员透视外发光。
    "CTZiplineColor": "80 180 255 255",
    "TZiplineColor": "255 80 80 255",
    "GlobalZiplineColor": "255 255 255 255",
    "AdminVisionGlowRange": 5000,

    // 声音事件留空时仅禁用该声音，不改变滑索状态机。
    "PrecacheSoundEvent": "soundevents/hanziplinesounds.vsndevts",
    "CreateSound": "han.zipline.ziplinecreace",
    "BuildSound": "han.zipline.ziplinefire",
    "RideStartSound": "han.zipline.start",
    "RideLoopSound": "han.zipline.slideloop",
    "RideLoopInterval": 0.5,
    "RideEndSound": "han.zipline.end",
    "SoundVolume": 1.0,
    "SoundPitch": 1.0,
    "RealisticBuild": true,

    // 高级摆放参数。SurfaceOffset 让纯视觉端点略微离开 Trace 命中面。
    "SurfaceOffset": 2.0,
    "GroundTraceDistance": 256.0
  }
}
